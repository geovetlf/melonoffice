{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "outputs": [],
      "env": ["FIRESTORE_EMULATOR_HOST", "REQUIRE_FIRESTORE_EMULATOR"]
    }
  }
}
