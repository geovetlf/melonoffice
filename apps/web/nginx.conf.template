# Serves the Vite build of apps/web. Cloud Run terminates TLS in front of this server.
# A template: at start-up nginx fills in the MELONOFFICE_* variables from the service's
# environment (ADR-0036). Neither is a secret: the API origin and a restricted browser key.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  server_tokens off;
  absolute_redirect off;

  add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com ${MELONOFFICE_API_URL}; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header X-Frame-Options "DENY" always;

  # Liveness endpoint for Cloud Run probes and the CD health check.
  location = /health {
    default_type application/json;
    return 200 '{"status":"ok","service":"web"}';
  }

  # The app's runtime configuration (ADR-0036), so one build serves every environment. Empty
  # values mean sign-in is not set up here; the app then says so.
  location = /config.json {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options "nosniff" always;
    return 200 '{"apiUrl":"${MELONOFFICE_API_URL}","identityApiKey":"${MELONOFFICE_IDENTITY_API_KEY}"}';
  }

  # Hashed build assets never change, so browsers may cache them for a year.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # Single-page app: unknown paths serve index.html, which is never cached.
  location / {
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com ${MELONOFFICE_API_URL}; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    try_files $uri /index.html;
  }
}
